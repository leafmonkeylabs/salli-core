{
  "name": "@leafmonkeylabs/salli-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Salli personal finance API",
  "license": "AGPL-3.0-only",
  "author": "Leaf Monkey Labs",
  "homepage": "https://github.com/leafmonkeylabs/salli-core/tree/main/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leafmonkeylabs/salli-core.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "eventsource-parser": "^4.1.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0"
  }
}
