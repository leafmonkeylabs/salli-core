{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@leafmonkeylabs/salli-sdk": [
        "../sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "*.config.ts",
    "*.config.mts",
    "../sdk/src/env.d.ts"
  ]
}
