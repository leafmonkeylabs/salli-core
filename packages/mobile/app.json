{
  "expo": {
    "name": "Salli",
    "slug": "salli",
    "scheme": "money.salli.app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "money.salli.app",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.money.salli.app"
        ]
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSFaceIDUsageDescription": "Salli opens with Face ID, so only you see your books."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      },
      "appleTeamId": "DUWFNX67SN"
    },
    "android": {
      "package": "money.salli.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#173B33"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-web-browser",
      "@bacons/apple-targets",
      "expo-background-task",
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Salli opens with Face ID, so only you see your books."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F3F2EF",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#0E1110"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Bold",
            "ios": "./assets/icons/Bold.png",
            "android": {
              "foregroundImage": "./assets/icons/Bold-foreground.png",
              "backgroundColor": "#0B0B0C"
            }
          },
          {
            "name": "Aurora",
            "ios": "./assets/icons/Aurora.png",
            "android": {
              "foregroundImage": "./assets/icons/Aurora-foreground.png",
              "backgroundColor": "#0A0E1F"
            }
          }
        ]
      ]
    ],
    "owner": "chandralegend",
    "extra": {
      "eas": {
        "projectId": "7164ae17-7c2c-47f3-9aa1-db6fb77683ea"
      }
    }
  }
}
