{
  "expo": {
    "name": "Salli",
    "slug": "salli",
    "scheme": "money.salli.app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "money.salli.app",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.money.salli.app"
        ]
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSFaceIDUsageDescription": "Salli opens with Face ID, so only you see your books."
      }
    },
    "android": {
      "package": "money.salli.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#173B33"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-web-browser",
      "@bacons/apple-targets",
      "expo-background-task",
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Salli opens with Face ID, so only you see your books."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F3F2EF",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#0E1110"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Bold",
            "ios": "./assets/icons/Bold.png",
            "android": {
              "foregroundImage": "./assets/icons/Bold-foreground.png",
              "backgroundColor": "#0B0B0C"
            }
          },
          {
            "name": "Aurora",
            "ios": "./assets/icons/Aurora.png",
            "android": {
              "foregroundImage": "./assets/icons/Aurora-foreground.png",
              "backgroundColor": "#0A0E1F"
            }
          }
        ]
      ]
    ]
  }
}
