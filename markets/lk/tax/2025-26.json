  "roles": [
    {
      "key": "employment_income",
      "kind": "income",
      "label": "Employment income (gross, before the employee's EPF contribution)",
      "description": "Salary, allowances and the taxable value of non-cash benefits. The employee's 8% EPF contribution is not deducted: the APIT tables allow no exemption beyond the Third Schedule."
    },
    {
      "key": "interest_income",
      "kind": "income",
      "label": "Interest (gross, before AIT)",
      "description": "Interest on rupee deposits, treasury bills and bonds, gross of the advance income tax withheld. Interest on approved foreign-currency accounts is exempt: do not tag it."
    },
    {
      "key": "rent_income",
      "kind": "income",
      "label": "Rent received"
    },
    {
      "key": "other_income",
      "kind": "income",
      "label": "Other assessable income"
    },
    {
      "key": "realised_gain",
      "kind": "income",
      "label": "Taxable gains on realising investment assets",
      "description": "Only taxable gains: gains on shares quoted on a licensed stock exchange, on a qualifying principal residence, and a gain of up to 50,000 when the year's gains are at most 600,000 are exempt. A loss is never set off against a gain."
    },
    {
      "key": "withdrawal",
      "kind": "other",
      "label": "Payouts from approved or regulated provident funds (EPF)",
      "description": "Exempt; declared on the return as exempt income."
    },
    {
      "key": "solar_expenditure",
      "kind": "deduction",
      "label": "Solar panels connected to the national grid (spent or loan repaid this year)"
    },
    {
      "key": "donations",
      "kind": "deduction",
      "label": "Donations in money to an approved charity"
    },
    {
      "key": "apit_withheld",
      "kind": "withholding",
      "label": "APIT deducted by employers"
    },
    {
      "key": "interest_wht",
      "kind": "withholding",
      "label": "AIT/WHT deducted from interest"
    },
    {
      "key": "cgt_paid",
      "kind": "withholding",
      "label": "Capital gains tax already paid on realisation"
    },
    {
      "key": "instalments_paid",
      "kind": "withholding",
      "label": "Quarterly instalments paid"
    }
  ],
  "questions": [],
  "band_tables": {
    "progressive": {
      "label": "Rates on taxable income",
      "bands": [
        {
          "upto": "1000000",
          "rate": "0.06"
        },
        {
          "upto": "1500000",
          "rate": "0.18"
        },
        {
          "upto": "2000000",
          "rate": "0.24"
        },
        {
          "upto": "2500000",
          "rate": "0.30"
        },
        {
          "upto": null,
          "rate": "0.36"
        }
      ],
      "source": "act_2025"
    }
  },
  "blocks": [
    {
      "type": "relief",
      "key": "solar_relief",
      "label": "Solar panel relief",
      "of": "role.solar_expenditure",
      "amount": "600000",
      "source": "chart"
    },
    {
      "type": "relief",
      "key": "personal_relief",
      "label": "Personal relief",
      "of": "line.after_other_reliefs",
      "amount": "1800000",
      "source": "act_2025"
    },
    {
      "type": "schedule",
      "key": "income_tax",
      "label": "Income tax at progressive rates",
      "of": "line.taxable",
      "table": "progressive"
    },
    {
      "type": "final_rate",
      "key": "cgt",
      "label": "Tax on gains from realising investment assets",
      "of": "role.realised_gain",
      "rate": "0.10",
      "source": "cgt"
    },
    {
      "type": "credit",
      "key": "apit",
      "label": "APIT credit",
      "of": "role.apit_withheld",
      "refundable": true,
      "source": "guide"
    },
    {
      "type": "credit",
      "key": "ait",
      "label": "AIT on interest credit",
      "of": "role.interest_wht",
      "refundable": true,
      "source": "guide"
    },
    {
      "type": "credit",
      "key": "cgt_credit",
      "label": "Capital gains tax paid",
      "of": "role.cgt_paid",
      "refundable": true,
      "source": "guide"
    },
    {
      "type": "credit",
      "key": "instalments",
      "label": "Instalments paid",
      "of": "role.instalments_paid",
      "refundable": true,
      "source": "guide"
    }
  ],
  "lines": [
    {
      "key": "assessable",
      "label": "Assessable income (gains excluded)",
      "expr": "role.employment_income + role.interest_income + role.rent_income + role.other_income"
    },
    {
      "key": "rent_relief",
      "label": "Rent relief (25% of rent)",
      "expr": "role.rent_income * 0.25",
      "source": "chart"
    },
    {
      "key": "after_other_reliefs",
      "label": "Assessable income less rent and solar relief",
      "expr": "max(0, line.assessable - line.rent_relief - line.solar_relief)"
    },
    {
      "key": "donation_relief",
      "label": "Qualifying payment: donations to approved charities",
      "expr": "min(role.donations, 75000, line.assessable / 4)",
      "source": "guide"
    },
    {
      "key": "taxable",
      "label": "Taxable income",
      "expr": "max(0, line.personal_relief.remaining - line.donation_relief)"
    },
    {
      "key": "tax_before_credits",
      "label": "Total tax payable",
      "expr": "line.income_tax + line.cgt"
    },
    {
      "key": "balance",
      "label": "Balance tax payable",
      "expr": "line.tax_before_credits - line.apit - line.ait - line.cgt_credit - line.instalments"
    }
  ],
  "result": {
    "net": "line.balance",
    "round": {
      "mode": "nearest",
      "unit": "0.01"
    }
  },
  "deadlines": [
    {
      "key": "instalment_1",
