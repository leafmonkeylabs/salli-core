# Salli's settings. Copy to .env and set only what you need; never commit .env.
# Every setting is in docs/self-host.md.
#
# With compose.yaml, none is needed to start: the database and the server's
# secrets are set up for you, and the secrets are generated on the first run
# (the `secrets` volume). Each line below is an example, not a value to keep.

# ── This server, as clients reach it ─────────────────────────────────────────
# Its public URL: what OAuth and MCP clients are told, and where the sign-in
# pages are. With the tls profile, https://<SALLI_DOMAIN>.
SALLI_PUBLIC_URL=http://localhost:8000

# compose.yaml only: where the server's port is published (default: this
# machine only), and the domain Caddy serves with HTTPS (the tls profile).
# SALLI_BIND=127.0.0.1
# SALLI_PORT=8000
# SALLI_DOMAIN=money.example.org
# The image to run (default: the release this compose.yaml names).
# SALLI_IMAGE=ghcr.io/leafmonkeylabs/salli:0.5.0

# ── AI ───────────────────────────────────────────────────────────────────────
# Every AI feature (chat, statement parsing, the advisor, FIRE strategies) runs
# on this key unless a user brings their own: an Anthropic or OpenAI key
# (`salli llm-keys set`), or their ChatGPT plan (`salli ai connect chatgpt`).
# Leave blank to use Salli without AI, or only on what users bring.
ANTHROPIC_API_KEY=
# Optional: web search for the agents, and tracing.
# TAVILY_API_KEY=
# LANGSMITH_API_KEY=

# ── Instance ─────────────────────────────────────────────────────────────────
# The base currency a new account starts in when none is named (ISO 4217).
# `salli-server setup` asks for yours; existing accounts keep theirs.
# SALLI_DEFAULT_CURRENCY=USD
# Web pages on these origins may call the API from a browser (comma-separated).
# None by default: the CLI, scripts and MCP clients need none.
# ALLOWED_ORIGINS=https://app.example.org
# How long a sign-in session lasts, in hours, and how long it may sit unused.
# SALLI_SESSION_TTL_HOURS=12
# SALLI_SESSION_IDLE_MINUTES=120
# Users may power Salli's AI with their ChatGPT plan (Sign in with ChatGPT).
# OpenAI offers this to open-source and self-hosted apps.
# SALLI_CHATGPT_PLAN_USAGE=true
# LOG_LEVEL=INFO

# ── Development, without compose (a checkout: CONTRIBUTING.md) ───────────────
# A local Postgres; `uv run salli-server setup` writes the server's secrets
# (BYOK_ENCRYPTION_KEYS, MCP_SIGNING_SECRET, CRON_SECRET) here for you.
# DATABASE_URL=postgresql+asyncpg://salli:salli@127.0.0.1:5432/salli
# ENVIRONMENT=development
# SALLI_STORAGE_DIR=
