# Salli configuration. `uv run salli-server setup` writes most of this for you from
# `supabase status`; copy to .env and edit only what you need. Never commit .env.

# ── Database and auth (local Supabase: `supabase start`) ─────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── The instance's owner (written by `salli-server setup`) ──────────────────
SALLI_USER_ID=

# ── Your own LLM key ─────────────────────────────────────────────────────────
# Every AI feature (chat, statement parsing, the advisor, FIRE strategies) runs
# on this key unless a user brings their own: an Anthropic or OpenAI key
# (`salli llm-keys set`), or their ChatGPT plan (`salli ai connect chatgpt`).
# Leave blank to use Salli without AI, or only on what users bring.
ANTHROPIC_API_KEY=
# Optional: web search for the agent, and tracing.
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=salli

# ── Generated by `salli-server setup` ────────────────────────────────────────
# Encrypts per-user LLM keys at rest ("version:base64(32 bytes)").
BYOK_ENCRYPTION_KEYS=
# Signs MCP connection requests.
MCP_SIGNING_SECRET=
# Authenticates the scheduler routes (POST /v1/advisor/cron/run-due and
# /v1/bank-connections/cron/sync-due). Or run `salli-server jobs` from cron.
CRON_SECRET=

# ── Instance ─────────────────────────────────────────────────────────────────
# closed: only accounts you create (`salli-server setup`, `salli-server members add`).
SALLI_REGISTRATION=closed
# local: uploaded statements and receipts stay in ~/.salli/storage.
SALLI_STORAGE=local
# The base currency a new account starts in when none is named (ISO 4217).
# `salli-server setup` asks for yours; existing accounts keep theirs.
SALLI_DEFAULT_CURRENCY=USD
# Users may power Salli's AI with their ChatGPT plan (Sign in with ChatGPT).
# OpenAI offers this to open-source and self-hosted apps; a paid or remotely
# hosted product needs OpenAI's approval first, and sets this to false until then.
SALLI_CHATGPT_PLAN_USAGE=true
# This API's public URL, as MCP clients (Claude, ChatGPT) see it.
MCP_PUBLIC_BASE_URL=http://localhost:8000
ADVISOR_API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
BASE_CURRENCY=LKR
