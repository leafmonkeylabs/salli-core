# Salli configuration. `uv run salli setup` writes most of this for you from
# `supabase status`; copy to .env and edit only what you need. Never commit .env.

# ── Database and auth (local Supabase: `supabase start`) ─────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── The CLI acts as this user (written by `salli setup`) ─────────────────────
SALLI_USER_ID=

# ── Your own LLM key ─────────────────────────────────────────────────────────
# Every AI feature (chat, statement parsing, the advisor, FIRE strategies) runs
# on this key. Leave blank to use Salli without AI.
ANTHROPIC_API_KEY=
# Optional: web search for the agent, and tracing.
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=salli

# ── Generated by `salli setup` ───────────────────────────────────────────────
# Encrypts per-user LLM keys at rest ("version:base64(32 bytes)").
BYOK_ENCRYPTION_KEYS=
# Signs MCP connection requests.
MCP_SIGNING_SECRET=
# Authenticates the daily advisor trigger (POST /advisor/cron/run-due).
CRON_SECRET=

# ── Instance ─────────────────────────────────────────────────────────────────
# closed: only accounts you create (`salli setup`, `salli members add`).
SALLI_REGISTRATION=closed
# local: uploaded statements and receipts stay in ~/.salli/storage.
SALLI_STORAGE=local
# This API's public URL, as MCP clients (Claude, ChatGPT) see it.
MCP_PUBLIC_BASE_URL=http://localhost:8000
ADVISOR_API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
BASE_CURRENCY=LKR
