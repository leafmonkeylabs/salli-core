{
  "name": "salli-core-js",
  "private": true,
  "description": "Salli's TypeScript packages: the SDK and the salli command-line tool",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "npm run generate --workspace @leafmonkeylabs/salli-sdk",
    "check:generated": "npm run generate && git diff --exit-code -- packages/sdk/src/generated && test -z \"$(git status --porcelain -- packages/sdk/src/generated)\"",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "binaries": "npm run binaries --workspace salli --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
